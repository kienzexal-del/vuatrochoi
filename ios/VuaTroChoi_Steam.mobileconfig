			<key>PayloadDisplayName</key>
			<string>Vua Tro Choi — Steam High-Speed</string>
			<key>PayloadDescription</key>
			<string>Ma hoa DNS ket noi truc tiep cum may chu Steam trong nuoc, tranh chan DPI va loi load trang.</string>
