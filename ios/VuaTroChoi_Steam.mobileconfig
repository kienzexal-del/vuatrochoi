<plist version="1.0">
<dict>
	<key>PayloadDisplayName</key>
	<string>Vua Trò Chơi (Mở Khóa Steam Tốc Độ Cao)</string>
	<key>PayloadDescription</key>
	<string>Giải pháp mở khóa Steam tốc độ cao, tải mượt Store, Wishlist và sửa lỗi đăng nhập Steam Mobile trên iOS. Không tốn pin, hoạt động cả Wi-Fi và 4G/5G.</string>
	<key>PayloadIdentifier</key>
	<string>com.vuatrochoi.dns.steam</string>
	<key>PayloadUUID</key>
	<string>47F9AE80-4F40-4A2D-874E-CDCC93A01AAE</string>
	<key>PayloadType</key>
	<string>Configuration</string>
	<key>PayloadVersion</key>
	<integer>1</integer>
	<key>PayloadOrganization</key>
	<string>Vua Trò Chơi</string>
	<key>PayloadContent</key>
	<array>
		<dict>
			<key>PayloadDisplayName</key>
			<string>Vua Trò Chơi — Steam Cloudflare Ultra</string>
			<key>PayloadDescription</key>
			<string>Mã hóa DNS Cloudflare Anycast siêu tốc, khắc phục triệt để lỗi vỡ giao diện CSS và nghẽn đăng nhập Steam.</string>
			<key>PayloadIdentifier</key>
			<string>com.apple.dnsSettings.managed.47F9AE80-4F40-4A2D-874E-CDCC93A01AAE</string>
