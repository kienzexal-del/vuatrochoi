			<key>PayloadDescription</key>
			<string>Cấu hình DNS mã hóa (DoH - Google Secure DNS) mở khóa Steam Store, Community và tối ưu mạng game.</string>
			<key>PayloadDisplayName</key>
			<string>Vua Trò Chơi - DNS Google DoH</string>
